# Show sync server (flash-api)
SHOW_WS_PORT=3202
# Public tunnel or API origin. Local dev can leave this unset.
# SHOW_SERVER_ORIGIN=https://your-tunnel.trycloudflare.com
# NEXT_PUBLIC_SHOW_WS_URL=wss://your-tunnel.trycloudflare.com
# Operator login — set on the API process (defaults exist for local demo)
# SHOW_OPERATOR_USER=
# SHOW_OPERATOR_PASS=
